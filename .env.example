# Auth / actor identity used by Streamlit and API audit logs
APP_API_KEY=dev_user

# Prod hardening (no-leak defaults)
# DATA_DIR local store (override to persistent disk in prod, e.g. /var/data/data_store)
DATA_DIR=data_store
# Comma-separated allowed origins; default * for local dev only
CORS_ORIGINS=*
# Set to enforce HMAC JWT on privileged actions (review/promote/share)
JWT_SECRET=
# Optional S3 mirror bucket for raw uploads (local remains source of truth)
S3_BUCKET=
# Queue / cache
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO

# Frontend deployment:
# - local dev defaults to http://localhost:8000
# - deployed frontend defaults to same-origin /api proxy
# Optional direct browser-to-backend override:
VITE_API_BASE_URL=

# Vercel same-origin proxy target for /api/* requests.
# Set this in your Vercel project environment variables to the FastAPI backend base URL.
BACKEND_API_URL=

# LLM provider selection: azure|openai
AI_PROVIDER=azure

# Azure OpenAI (primary)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# OpenAI fallback (used when Azure is not configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
